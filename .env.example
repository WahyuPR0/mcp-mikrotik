# MikroTik RouterOS Connection Settings
MIKROTIK_HOST=192.168.88.1
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=your_router_password_here
MIKROTIK_PORT=2022

# MCP Server Port (HTTP / SSE mode)
PORT=2024

# Timezone for logging (e.g. Asia/Jakarta, Asia/Pontianak, UTC)
TIMEZONE=Asia/Jakarta

# Security & Authentication Tokens
MCP_TOKEN=your_secure_random_token_here
MCP_CLIENT_ID=mcp-mikrotik-client
MCP_CLIENT_SECRET=your_secure_client_secret_here
